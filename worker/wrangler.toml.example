# Скопируй в wrangler.toml и поправь под себя. Сам wrangler.toml НЕ коммить,
# если боишься светить имя воркера — пример достаточен для деплоя руками.
#
# Секреты ставятся отдельно (НЕ в этот файл):
#   npx wrangler secret put TELEGRAM_BOT_TOKEN   # токен бота из BotFather
#   npx wrangler secret put WEBHOOK_SECRET       # ОБЯЗАТЕЛЕН (патч №12):
#                                               # без него /api/webhook отвечает
#                                               # 401 fail-closed. Та же строка,
#                                               # что в secret_token при setWebhook.

name = "ofeliya-payments"
main = "src/index.ts"
compatibility_date = "2026-10-21"

# Патч №13: журнал платежей на Cloudflare D1 (схема — worker/schema.sql).
# KV-биндинг PAYMENTS удалён из кода полностью (чистая замена, не fallback).
#
# Создать базу:        wrangler d1 create ofeliya-payments
# Применить схему:     wrangler d1 execute ofeliya-payments --file=worker/schema.sql
# Подставить выданный database_id ниже. Без биндинга воркер работает
# в деградированном режиме (/api/invoice → 503, pre_checkout → ok:false,
# /api/entitlements, /api/verify и /api/ack → 501).
[[d1_databases]]
binding = "PAYMENTS_DB"
database_name = "ofeliya-payments"
database_id = "REPLACE_ME"  # ← вставить id из `wrangler d1 create`
