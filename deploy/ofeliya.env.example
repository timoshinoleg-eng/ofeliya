# Copy to /opt/ofeliya/.env on the production host. Never commit real secrets.

# OFELIYA owns a dedicated MAX bot. Hub/Chatbot24 credential sharing is retired.
OFELIYA_BOT_MODE=dedicated
# Optional separate MAX app verification token. If empty, deployment uses the dedicated
# OFELIYA_BOT_TOKEN; never use a Hub/Chatbot24 token here.
OFELIYA_MAX_BOT_TOKEN=
OFELIYA_BOT_TOKEN=
OFELIYA_BOT_USERNAME=id402806822924_5_bot

# Public webhook for the same dedicated bot.
OFELIYA_BOT_WEBHOOK_DOMAIN=https://ofeliya.freeveol.dpdns.org
OFELIYA_BOT_WEBHOOK_PORT=8788
OFELIYA_BOT_WEBHOOK_PATH=/ofeliya/bot/webhook
OFELIYA_BOT_WEBHOOK_SECRET=

# Public Mini App URL configured for this bot in MAX.
OFELIYA_GAME_URL=https://ofeliya.freeveol.dpdns.org/ofeliya/

# Dedicated Cloud.ru host integration. These resources are Ofeliya-owned.
OFELIYA_SHARED_NETWORK=deploy_ofeliya
OFELIYA_EXTRA_CA_CERT=/opt/ofeliya/certs/ca-certificates.crt

# Strain Zero legal/support fields embedded into the static production build.
# The product brand is OFELIYA; the legal operator is configured separately below.
OFELIYA_DEVELOPER_BRAND=OFELIYA
OFELIYA_DEVELOPER_LEGAL_NAME=
OFELIYA_DEVELOPER_REGISTRATION=
OFELIYA_DEVELOPER_ADDRESS=
OFELIYA_SUPPORT_EMAIL=
OFELIYA_SUPPORT_PHONE=

# Optional Telegram release wiring.
# Frontend values are public build-time identifiers (omit @ from the bot username).
# A short name is only needed for direct Mini App links; Main Mini App links work without it.
VITE_TG_BOT_USERNAME=
VITE_TELEGRAM_APP_SHORT_NAME=
# Optional explicit launch URL used by the Telegram long-polling bot. When omitted,
# deploy derives https://t.me/<bot>?startapp=play (or /<short-name>?startapp=play).
OFELIYA_TELEGRAM_GAME_URL=
# Cloud.ru currently cannot reach the DNS-selected Telegram API address reliably.
# Leave blank only after confirming api.telegram.org is reachable directly from production.
OFELIYA_TELEGRAM_API_IP=149.154.167.220
# Production mode: webhook avoids dependence on outbound Telegram Bot API routing.
OFELIYA_TELEGRAM_BOT_MODE=webhook
# Disable outbound prepared-message/referrer calls when Cloud.ru cannot reach Bot API.
OFELIYA_TELEGRAM_OUTBOUND_ENABLED=0
# Secret sent by Telegram in X-Telegram-Bot-Api-Secret-Token for webhook requests.
TG_WEBHOOK_SECRET=
# Server secret used for Telegram initData validation and bot ownership.
# Never reuse a MAX/Chatbot24 token.
TG_BOT_TOKEN=

# Optional VK integration used by score-server.
VK_SECURE_KEY=
