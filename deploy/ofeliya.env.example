# Copy to /opt/ofeliya/.env on the production host. Never commit real secrets.

# MAX bot mode. Production currently reuses the Hub/Quizika bot identity.
OFELIYA_BOT_MODE=shared
OFELIYA_BOT_ENV_FILE=/opt/hub/.env

# Dedicated-mode overrides (leave empty in shared mode).
OFELIYA_BOT_TOKEN=
OFELIYA_BOT_USERNAME=id0000000000_ofeliya_bot

# Public webhook for the same bot.
OFELIYA_BOT_WEBHOOK_DOMAIN=https://games.example.ru
OFELIYA_BOT_WEBHOOK_PORT=8788
OFELIYA_BOT_WEBHOOK_PATH=/ofeliya/bot/webhook
OFELIYA_BOT_WEBHOOK_SECRET=

# Public Mini App URL configured for this bot in MAX.
OFELIYA_GAME_URL=https://games.example.ru/ofeliya/

# Existing Cloud.ru shared-host integration. These are Ofeliya-owned settings.
OFELIYA_SHARED_NETWORK=quiz-battle_default
OFELIYA_EXTRA_CA_CERT=/opt/quiz-battle/certs/ca-certificates.crt

# Strain Zero legal/support fields embedded into the static production build.
OFELIYA_DEVELOPER_BRAND=ChatBot24
OFELIYA_DEVELOPER_LEGAL_NAME=
OFELIYA_DEVELOPER_REGISTRATION=
OFELIYA_DEVELOPER_ADDRESS=
OFELIYA_SUPPORT_EMAIL=
OFELIYA_SUPPORT_PHONE=

# Optional Telegram/VK integrations used by score-server.
TG_BOT_TOKEN=
VK_SECURE_KEY=
