# Copy to /opt/ofeliya/.env on the production host. Never commit real secrets.

# Dedicated MAX bot attached to the Ofeliya Mini App.
OFELIYA_BOT_TOKEN=
OFELIYA_BOT_USERNAME=id0000000000_ofeliya_bot

# Public webhook for the same bot.
OFELIYA_BOT_WEBHOOK_DOMAIN=https://games.example.ru
OFELIYA_BOT_WEBHOOK_PORT=8788
OFELIYA_BOT_WEBHOOK_PATH=/ofeliya/bot/webhook
OFELIYA_BOT_WEBHOOK_SECRET=

# Public Mini App URL configured for this bot in MAX.
OFELIYA_GAME_URL=https://games.example.ru/ofeliya/

# Optional Telegram/VK integrations used by score-server.
TG_BOT_TOKEN=
VK_SECURE_KEY=
