# Public MAX bot username/name bound to this Mini App, without leading @.
VITE_MAX_BOT_NAME=your_max_bot_name

# User-facing developer/legal information required for the MAX release build.
# Replace placeholders with the exact data of the verified MAX developer profile.
VITE_DEVELOPER_BRAND=ChatBot24
VITE_DEVELOPER_LEGAL_NAME=your_legal_name
VITE_DEVELOPER_REGISTRATION=your_registration_details
VITE_DEVELOPER_ADDRESS=your_legal_address
VITE_SUPPORT_EMAIL=info@chatbot24.su
VITE_SUPPORT_PHONE=
